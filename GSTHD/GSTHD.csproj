<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <AssemblyVersion>0.9.0.0</AssemblyVersion>
        <AssemblyTitle>GSTHD: DK64 Edition</AssemblyTitle>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsWindows Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' == 'true'">true</IsWindows>
    </PropertyGroup>

    <PropertyGroup Condition="'$(IsWindows)'=='true'">
        <DefineConstants>WINDOWS</DefineConstants>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="AsyncImageLoader.Avalonia" Version="3.6.0" />
        <PackageReference Include="Avalonia" Version="12.0.999-cibuild0063886-alpha" />
        <PackageReference Include="Avalonia.Desktop" Version="12.0.999-cibuild0063886-alpha" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.999-cibuild0063886-alpha" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.999-cibuild0063886-alpha" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1" />
        <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
        <PackageReference Include="MessageBox.Avalonia" Version="3.3.1.1" />
        <PackageReference Include="NetSparkleUpdater.UI.Avalonia" Version="3.1.0-preview20260409001" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <AvaloniaResource Include="Resources\**" />
        <TrimmerRootAssembly Include="GSTHD" />
        <TrimmerRootAssembly Include="Newtonsoft.Json" />
    </ItemGroup>
</Project>
